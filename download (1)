                        rows={5}
                        value={contactMessage}
                        onChange={(e) => setContactMessage(e.target.value)}
                        className={`w-full bg-slate-950 border ${
                          formErrors.message ? 'border-red-500/50 focus:border-red-500' : 'border-slate-800 focus:border-cyan-500/50'
                        } rounded-xl px-4 py-3 text-xs md:text-sm text-slate-100 placeholder-slate-600 focus:outline-none transition-all resize-none`}
                        placeholder={language === 'fr' ? "Bonjour l'équipe Team 21..." : "Hello Team 21 team..."}
                      />
                      {formErrors.message && (
                        <span className="text-[10px] font-semibold text-red-400 block mt-1">{formErrors.message}</span>
                      )}
                    </div>

                    {/* Submit Button */}
                    <button
                      id="btn-email-submit"
                      type="submit"
                      className="w-full inline-flex items-center justify-center gap-2 px-5 py-4 rounded-xl bg-gradient-to-r from-blue-600 to-cyan-500 hover:from-blue-500 hover:to-cyan-400 text-slate-950 font-black tracking-wide text-xs uppercase shadow-lg shadow-cyan-500/10 cursor-pointer"
                    >
                      <Mail className="w-4 h-4 text-slate-950" />
                      <span>{t.sendBtn}</span>
                    </button>

                  </form>
                )}

              </div>

            </div>

          </div>
        )}

      </main>

      {/* --- FOOTER --- */}
      <footer className="mt-auto border-t border-slate-900 bg-slate-950/40 py-8 text-center text-slate-500 text-xs font-medium">
        <div className="w-full max-w-7xl mx-auto px-4 md:px-8 flex flex-col md:flex-row items-center justify-between gap-4">
          <p>
            © {new Date().getFullYear()} <span className="text-slate-300 font-bold">{t.brand} Academy</span>. {language === 'fr' ? "Tous droits réservés." : "All rights reserved."}
          </p>
          <div className="flex items-center gap-4 text-[11px] font-semibold">
            <span className="text-[#3b82f6]">{language === 'fr' ? "Portail Officiel de Leadership" : "Official Leadership Portal"}</span>
            <span className="text-slate-700">|</span>
            <span>+237 694 294 406</span>
            <span className="text-slate-700">|</span>
            <span>forteh@gmail.com</span>
          </div>
        </div>
      </footer>

    </div>
  );
}
