    e.preventDefault();
    if (!chatInput.trim()) return;

    const userMsg = chatInput.trim();
    setChatInput('');

    // Append user message
    const updatedMessages = [
      ...chatMessages,
      { role: 'user' as const, content: userMsg, timestamp: new Date() }
    ];
    setChatMessages(updatedMessages);
    setChatLoading(true);

